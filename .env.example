# OpenAI-compatible inference API exposed to agent clients:
LOCAL_AGENT_BASE_URL=http://127.0.0.1:11434/v1

# Logical default model used by the stack:
LOCAL_AGENT_MODEL=qwen3.6:35b-mlx

# Agent-client transport.
# Use an SSH host or alias resolvable from ~/.ssh/config.
LOCAL_AGENT_SSH_TARGET=
LOCAL_AGENT_LOCAL_PORT=11434
LOCAL_AGENT_REMOTE_PORT=11434
