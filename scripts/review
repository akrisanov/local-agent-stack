#!/usr/bin/env python3

import json
import sys
from pathlib import Path


def main() -> None:
    if len(sys.argv) != 3:
        raise SystemExit("Usage: ./scripts/review <harness> <task>")

    harness = sys.argv[1]
    task = sys.argv[2]

    if harness not in {"codex", "pi", "goose"}:
        raise SystemExit(f"Unknown harness: {harness}")

    repo_root = Path(__file__).resolve().parent.parent

    model_file = repo_root / "models" / "default-model"
    if not model_file.exists():
        raise SystemExit("models/default-model does not exist")

    model = model_file.read_text(encoding="utf-8").strip()
    model_slug = model.replace(":", "-").replace("/", "-")

    run_file = repo_root / "evals" / "runs" / model_slug / harness / task / "run.json"

    if not run_file.exists():
        raise SystemExit(
            f"No eval run found:\n  {run_file}\n"
            f"Run it first with:\n"
            f"  make eval HARNESS={harness} TASK={task}"
        )

    review_file = (
        repo_root / "evals" / "reviews" / model_slug / harness / f"{task}.json"
    )

    if review_file.exists():
        raise SystemExit(f"Review already exists: {review_file}")

    review = {
        "verdict": "",
        "recovery": "",
        "requirements_met": None,
        "final_answer": None,
        "notes": [],
    }

    review_file.parent.mkdir(parents=True, exist_ok=True)
    review_file.write_text(
        json.dumps(review, indent=2) + "\n",
        encoding="utf-8",
    )

    print(f"Created review: {review_file.relative_to(repo_root)}")


if __name__ == "__main__":
    main()
